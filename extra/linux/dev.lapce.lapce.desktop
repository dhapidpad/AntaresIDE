[Desktop Entry]
Version=1.0
Type=Application

Name=Antares IDE
Comment=Lightning-fast and powerful code editor in Rust with Octomind ACP AI agent
Categories=Development;IDE;
GenericName=AI Code Editor
StartupWMClass=lapce

Icon=dev.lapce.lapce
Exec=lapce %F
Terminal=false
MimeType=text/plain;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=lapce --new %F
Icon=dev.lapce.lapce
